# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=localhost

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME='Digital Twin Toolbox'
STACK_NAME=digital-twin-toolbox

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:8081,https://localhost,https://localhost:5173,http://localhost.dtt-project.com"

# Provider in backend/app/auth, standalone = no in-app auth.
# AUTH_PROVIDER=standalone

# Postgres. Empty secrets are generated by ./scripts/init-env.sh.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Object storage (S3-compatible). Local dev uses the bundled gateway; cloud points at its own bucket.
S3_ENDPOINT_URL=http://versitygw:8333
S3_BUCKET=dtt
# In local dev these are both the gateway root and the client credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_CREATE_BUCKET=true
# Host folder served as buckets, and the uid:gid the gateway runs as.
# STORAGE_DATA_DIR=./data/versitygw
# STORAGE_UID=1000
# STORAGE_GID=1000

SENTRY_DSN=

# Deploy only (docker-compose.traefik.yml), HASHED_PASSWORD is an htpasswd hash.
# USERNAME=
# HASHED_PASSWORD=
# EMAIL=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=geosolutionsit/digital-twin-toolbox-backend
DOCKER_IMAGE_FRONTEND=geosolutionsit/digital-twin-toolbox-frontend
DOCKER_IMAGE_WORKER=geosolutionsit/digital-twin-toolbox-worker-vector
TAG=latest

DTT_API_URL=http://${DOMAIN}
# base path of the frontend routing
DTT_ROUTER_BASE_PATH=/
# location of all frontend assets files
DTT_PUBLIC_BASE_PATH=/
# if true enable the hash routing
DTT_ENABLE_ROUTER_HASH_HISTORY=False

# Tasks in parallel per worker service. Point-cloud and mesh tasks use several cores each.
CELERY_WORKER_CONCURRENCY=3
# WORKER_POINT_CLOUD_CONCURRENCY=2
# WORKER_MESH_CONCURRENCY=1
# Tiles built in parallel inside one mesh task (default min(cores, 4))
# MESH_TILING_WORKERS=4
# Container memory caps, e.g. 8g (0 = unlimited)
# WORKER_POINT_CLOUD_MEM_LIMIT=0
# WORKER_MESH_MEM_LIMIT=0

# Uncomment if dev hot reload misses changes (Docker Desktop / WSL2 on /mnt/c).
# WATCHFILES_FORCE_POLLING=true

# Uncomment so plain `docker compose up` runs with hot reload (mounted source + watchfiles).
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.dev.yml

# Host interface for the local Dozzle log viewer, 0.0.0.0 if localhost:9999 is unreachable.
# DOZZLE_BIND_HOST=127.0.0.1
