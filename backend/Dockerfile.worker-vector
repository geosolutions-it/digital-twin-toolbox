FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app/

ARG INSTALL_DEV=false
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    if [ "$INSTALL_DEV" = "true" ]; then \
      uv sync --frozen --no-install-workspace --group worker --group vector --group dev; \
    else \
      uv sync --frozen --no-install-workspace --no-dev --group worker --group vector; \
    fi

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgdal-dev build-essential && \
    uv pip install "GDAL==$(gdal-config --version).*" && \
    apt-get clean && rm -rf /var/lib/apt/lists/*


FROM python:3.11-slim

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app

WORKDIR /app/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgdal36 \
        ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv

COPY ./scripts/ /app/
COPY ./alembic.ini /app/
COPY ./prestart.sh /app/
COPY ./tests-start.sh /app/
COPY ./app /app/app

ENTRYPOINT ["bash", "-c"]
