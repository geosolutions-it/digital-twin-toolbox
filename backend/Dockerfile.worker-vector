FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app/

ARG INSTALL_DEV=false
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    if [ "$INSTALL_DEV" = "true" ]; then \
      uv sync --frozen --no-install-workspace --group worker --group vector --group dev; \
    else \
      uv sync --frozen --no-install-workspace --no-dev --group worker --group vector; \
    fi

RUN apt-get update && \
    apt-get install -y --no-install-recommends libgdal-dev build-essential && \
    uv pip install "GDAL==$(gdal-config --version).*" && \
    apt-get clean && rm -rf /var/lib/apt/lists/*


FROM python:3.11-slim

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PATH="/app/.venv/bin:/opt/citygml-tools:${PATH}"
ENV PYTHONPATH=/app
ENV MAGO_3D_TILER_JAR=/bin/mago-3d-tiler.jar
ENV CITYGML_TOOLS_BIN=/opt/citygml-tools/citygml-tools

WORKDIR /app/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gdal-bin \
        libgdal36 \
        openjdk-21-jre-headless \
        wget \
        unzip \
        ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv

RUN cd /bin && \
    wget https://github.com/Geodan/pg2b3dm/releases/download/v2.19.0/pg2b3dm-linux-x64.zip && \
    unzip ./pg2b3dm-linux-x64.zip && \
    rm -rf ./pg2b3dm-linux-x64.zip

RUN cd /bin && \
    wget https://github.com/Geodan/i3dm.export/releases/download/v2.11.0/i3dm.export-linux-x64.zip && \
    unzip ./i3dm.export-linux-x64.zip && \
    rm -rf ./i3dm.export-linux-x64.zip

RUN cd /tmp && \
    wget -q https://github.com/Gaia3D/mago-3d-tiler/releases/download/v1.15.4/mago-3d-tiler-1.15.4.jar && \
    mv mago-3d-tiler-1.15.4.jar /bin/mago-3d-tiler.jar && \
    wget -q https://github.com/citygml4j/citygml-tools/releases/download/v2.5.0/citygml-tools-2.5.0.zip && \
    unzip -q citygml-tools-2.5.0.zip && \
    mv citygml-tools-2.5.0 /opt/citygml-tools && \
    chmod +x /opt/citygml-tools/citygml-tools && \
    rm -rf /tmp/*

COPY ./scripts/ /app/
COPY ./alembic.ini /app/
COPY ./prestart.sh /app/
COPY ./tests-start.sh /app/
COPY ./app /app/app

ENTRYPOINT ["bash", "-c"]
