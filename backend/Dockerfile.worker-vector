FROM python:3.11-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        ninja-build \
        curl \
        ca-certificates \
        libgdal-dev \
        libgeotiff-dev \
        libxml2-dev \
        libzstd-dev \
        libcurl4-openssl-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Core stages only (readers/writers.las with built-in lazperf, filters.*): no plugins
ARG PDAL_VERSION=2.10.2
RUN curl -fsSL https://github.com/PDAL/PDAL/releases/download/${PDAL_VERSION}/PDAL-${PDAL_VERSION}-src.tar.gz | tar -xz -C /tmp && \
    cmake -S /tmp/PDAL-${PDAL_VERSION}-src -B /tmp/pdal-build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/pdal \
        -DWITH_TESTS=OFF && \
    cmake --build /tmp/pdal-build && \
    cmake --install /tmp/pdal-build && \
    rm -rf /tmp/PDAL-${PDAL_VERSION}-src /tmp/pdal-build && \
    echo /opt/pdal/lib > /etc/ld.so.conf.d/pdal.conf && ldconfig

WORKDIR /app/

ENV CMAKE_PREFIX_PATH=/opt/pdal
ARG INSTALL_DEV=false
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    if [ "$INSTALL_DEV" = "true" ]; then \
      uv sync --frozen --no-install-workspace --refresh-package pdal --group worker --group vector --group pointcloud --group dev; \
    else \
      uv sync --frozen --no-install-workspace --refresh-package pdal --no-dev --group worker --group vector --group pointcloud; \
    fi

RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install "GDAL==$(gdal-config --version).*"


FROM python:3.11-slim

ENV PATH="/app/.venv/bin:/opt/pdal/bin:$PATH" \
    PYTHONPATH=/app

WORKDIR /app/

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgdal36 \
        gdal-bin \
        ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/pdal/bin/pdal /opt/pdal/bin/pdal
COPY --from=builder /opt/pdal/lib/ /opt/pdal/lib/
RUN echo /opt/pdal/lib > /etc/ld.so.conf.d/pdal.conf && ldconfig

COPY --from=builder /app/.venv /app/.venv

RUN pdal --version && \
    python -c "import pdal, osgeo.gdal, py3dtiles, laspy, quantized_mesh_tile; print('python-pdal', pdal.__version__, 'gdal', osgeo.gdal.__version__)"

COPY ./scripts/ /app/
COPY ./alembic.ini ./prestart.sh ./tests-start.sh /app/
COPY ./app /app/app

ENTRYPOINT ["bash", "-c"]
